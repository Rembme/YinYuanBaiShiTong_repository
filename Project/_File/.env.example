# Local JDK. Set this when another Java version is earlier on PATH.
JAVA_HOME=

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/yinyuan
DB_USERNAME=yinyuan
DB_PASSWORD=change-me-locally

# JWT (generate a random value of at least 32 bytes for local development)
JWT_SECRET=replace-with-a-local-random-secret-at-least-32-bytes

# First admin bootstrap. Remove/rotate after setup.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# DeepSeek chat. deepseek-flash currently routes to DeepSeek V4.1 Flash.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Separate credential for DashScope text-embedding-v2
DASHSCOPE_API_KEY=
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBEDDING_MODEL=text-embedding-v2

# Email is optional; station inbox remains available without SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=


